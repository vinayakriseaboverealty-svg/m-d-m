<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Adapted from Fleet's it-and-security/lib/macos/configuration-profiles/screen-lock-inactivity.mobileconfig. -->
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Screen lock after inactivity</string>
			<key>PayloadIdentifier</key>
			<string>com.riseabovereality.screen-lock-inactivity.screensaver</string>
			<key>PayloadType</key>
			<string>com.apple.screensaver</string>
			<key>PayloadUUID</key>
			<string>EB9DF4BC-5685-4706-A496-77DD1EC1F49F</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<!-- Keep idleTime <= 900 and askForPasswordDelay <= 60 so the "Screen lock" policy passes. -->
			<key>idleTime</key>
			<integer>900</integer>
			<key>askForPassword</key>
			<true/>
			<key>askForPasswordDelay</key>
			<integer>60</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Starts the screen saver after 15 minutes of inactivity and requires a password within a minute of it starting or the display sleeping.</string>
	<key>PayloadDisplayName</key>
	<string>Screen lock after inactivity</string>
	<key>PayloadIdentifier</key>
	<string>com.riseabovereality.screen-lock-inactivity</string>
	<key>PayloadOrganization</key>
	<string>Rise Above Reality</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>25C8E681-F074-477C-8CB3-261249311301</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
</dict>
</plist>
