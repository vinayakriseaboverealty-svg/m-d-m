# Fleet UI, API, osquery/orbit agents, and Apple MDM check-ins. Devices connect from anywhere,
# so this must stay reachable from the internet.
{$FLEET_DOMAIN} {
	reverse_proxy fleet:8080
}

# Claude Code telemetry intake. The collector rejects requests without the bearer token.
{$OTEL_DOMAIN} {
	reverse_proxy otel-collector:4318
}

# Claude Code usage dashboards (Grafana login required).
{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}
