# Copy to .env with scripts/init-env.sh (fills the secrets for you). Never commit .env.
# Back up .env somewhere safe (a password manager): FLEET_SERVER_PRIVATE_KEY can't be recovered.

# Pin Fleet; upgrade deliberately (see docs/runbook.md "Upgrading Fleet").
FLEET_VERSION=v4.93.2

# DNS A records for all three must point at this droplet before first start.
FLEET_DOMAIN=mdm.riseabovereality.com
OTEL_DOMAIN=otel.riseabovereality.com
GRAFANA_DOMAIN=usage.riseabovereality.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=it@riseabovereality.com

# Generated by scripts/init-env.sh
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
FLEET_SERVER_PRIVATE_KEY=
CLAUDE_OTEL_TOKEN=
GRAFANA_ADMIN_PASSWORD=
