{
  "uid": "claude-code-usage",
  "title": "Claude Code usage",
  "tags": [
    "claude-code"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "editable": false,
  "description": "Claude Code usage per person, from the telemetry Claude Code sends to our collector. Users are identified by Claude account email; host_serial is the device serial from Fleet.",
  "panels": [
    {
      "id": 1,
      "title": "Estimated cost (selected range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"claude_code_cost_usage(_.*)?\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "Claude Code cost estimate in USD. Subscription seats are billed per seat, so treat this as relative usage, not an invoice."
    },
    {
      "id": 2,
      "title": "Active users (selected range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
